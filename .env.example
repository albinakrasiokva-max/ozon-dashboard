# ============================================================
#  BrandOS — ключи доступа. Скопируйте файл в .env и заполните.
#  .env лежит только на сервере, он в .gitignore. Не отправляйте ключи в чат и в GitHub.
#  Каждый источник включается, только если заполнены ВСЕ его переменные.
#  Без ключа блок дашборда показывает демо-данные с пометкой «демо».
# ============================================================

# --- Сервер ---
PORT=3000
# 127.0.0.1 — открыт только на этом компьютере. 0.0.0.0 — доступ из сети (запустится только с паролем ниже)
HOST=127.0.0.1

# Только для своего сервера с docker compose: домен, на который Caddy выпустит HTTPS-сертификат
DOMAIN=

# --- Вход в дашборд ---
# Общий пароль команды, не короче 10 символов. Без него сервер не откроется в сеть.
# Придумать надёжный:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
DASHBOARD_PASSWORD=
# Необязательно: секрет подписи сессий. Если пусто — создаётся сам и хранится в data/session-secret
SESSION_SECRET=
# За прокси (Caddy, nginx) поставьте 1 — тогда учитывается настоящий IP и HTTPS. На Railway включается само
TRUST_PROXY=
# 1 — cookie входа только по HTTPS (включайте, когда сайт работает по https)
COOKIE_SECURE=

# --- Настройки бизнеса на хостинге (необязательно) ---
# Путь к settings.json на постоянном диске; при первом запуске туда копируется шаблон
SETTINGS_FILE=
# Или весь settings.json одной строкой в переменной — удобно править в панели хостинга
SETTINGS_JSON=
# Часовой пояс для расчёта дней
TZ=Europe/Moscow

# --- Wildberries (с него лучше начать) ---
# 1. seller.wildberries.ru → Профиль (справа вверху) → Настройки → Доступ к API.
# 2. «Создать новый токен», тип — базовый.
# 3. Отметьте категории: Статистика, Аналитика, Документы, Продвижение. Включите «Только чтение».
# 4. Скопируйте токен целиком (он показывается один раз).
WB_TOKEN=
# Реклама WB берётся тем же токеном (категория «Продвижение»). Чтобы не загружать её, поставьте 0.
WB_ADS=1

# --- Ozon Seller ---
# 1. seller.ozon.ru → Настройки → API ключи → «Сгенерировать ключ».
# 2. Роль: Admin read only.
# 3. Client-Id — число над списком ключей; API-ключ показывается один раз.
OZON_CLIENT_ID=
OZON_API_KEY=

# --- Ozon Performance (реклама Ozon) ---
# Это ОТДЕЛЬНЫЙ кабинет, ключи Seller API сюда не подходят.
# 1. performance.ozon.ru → Настройки → API → «Создать аккаунт» (сервисный).
# 2. Скопируйте client_id и client_secret.
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# --- CRM: заполните ОДНУ из двух ---
# amoCRM:
# 1. amoCRM → Настройки → Интеграции → «Создать интеграцию» (внешняя).
# 2. Выдайте доступ: «Доступ к данным аккаунта». Сохраните.
# 3. На вкладке «Ключи и доступы» → «Долгосрочный токен» → сгенерировать, срок — максимальный.
# 4. Поддомен — часть адреса до .amocrm.ru (для mycompany.amocrm.ru → mycompany).
AMO_SUBDOMAIN=
AMO_TOKEN=
# Необязательно: ID воронки (по умолчанию — главная воронка)
AMO_PIPELINE_ID=

# Битрикс24:
# 1. Битрикс24 → Разработчикам → Другое → Входящий вебхук.
# 2. Права: CRM (crm). Для имён ответственных добавьте «Пользователи» (user).
# 3. Скопируйте адрес вида https://ваш-портал.bitrix24.ru/rest/1/abc123xyz/
BITRIX_WEBHOOK_URL=

# --- Банк: можно оба ---
# Т-Банк Бизнес:
# 1. business.tbank.ru → Интеграции (или «Настройки» → «Интеграции и API») → «Выпустить токен».
# 2. Права: только чтение — «Получение информации о счетах» и «Получение выписки».
TBANK_TOKEN=

# Точка:
# 1. i.tochka.com → Интеграции и API → «Подключить» → «Сгенерировать JWT-ключ».
# 2. Права: чтение счетов, остатков и выписок.
TOCHKA_TOKEN=

# --- Claude API (платно): распознавание документов и ИИ-чат ---
# 1. console.anthropic.com → войдите → Settings → API Keys → Create Key.
# 2. Пополните баланс: Settings → Billing. Оплата по объёму запросов.
ANTHROPIC_API_KEY=
# Необязательно: модель (по умолчанию claude-opus-5-5)
CLAUDE_MODEL=

# --- Почта (IMAP): документы из вложений писем ---
# 1. Нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не обычный пароль:
#    Яндекс: id.yandex.ru → Безопасность → Пароли приложений → «Почта» (и включите IMAP в настройках почты: Почтовые программы).
#    Google: myaccount.google.com → Безопасность → Двухэтапная аутентификация → Пароли приложений.
#    Mail.ru: Настройки → Безопасность → Пароли для внешних приложений.
# 2. Сервер определяется по адресу (яндекс, gmail, mail.ru). Для другой почты укажите MAIL_HOST.
# Письма не помечаются прочитанными; при первом запуске берутся письма за 14 дней.
MAIL_USER=
MAIL_PASSWORD=
MAIL_HOST=
MAIL_FOLDER=INBOX

# --- Telegram-бот: пересылайте ему счета и акты ---
# 1. В Telegram откройте @BotFather → /newbot → придумайте имя → скопируйте токен.
# 2. Запустите сервер и напишите боту — он ответит вашим chat id.
# 3. Впишите chat id (через запятую, если людей несколько) в TELEGRAM_ALLOWED_CHATS и перезапустите сервер.
#    Файлы из других чатов бот не принимает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=

# --- ЭДО Диадок (экспериментально) ---
# 1. developer.kontur.ru → получите ключ разработчика (client id).
# 2. Логин и пароль пользователя Диадока с доступом к ящику организации.
DIADOC_API_KEY=
DIADOC_LOGIN=
DIADOC_PASSWORD=
# Необязательно: ID ящика (по умолчанию — первый ящик первой организации)
DIADOC_BOX_ID=

# Документы из кабинета WB берутся токеном WB_TOKEN (категория «Документы»). Чтобы не загружать — 0.
WB_DOCS=1

# --- Хранение данных ---
# Папка с базой (на хостинге — постоянный диск)
DATA_DIR=data
